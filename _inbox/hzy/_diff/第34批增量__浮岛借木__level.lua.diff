+local function buildSky(palette)
+    local parent = state.containerBg or state.containerWorld
+    local rect = rectSlot()
+    local cw = state.canvasW or config.DEFAULT_VIEW_WIDTH
+    local ch = state.canvasH or config.DEFAULT_VIEW_HEIGHT
