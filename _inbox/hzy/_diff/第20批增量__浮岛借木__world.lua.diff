+-- 这一格是不是「树桩位」（地表要画出一截树桩 / 画地表时高度要减一层）
+function M.hasStump(c, r)
+    local at = state.stumpAt
+    if not at then return false end
+    return at[c .. ":" .. r] == true
+end
