+def dedupe_palette(centers, thresh):
+    """★ 这一步是「颜色预算」的关键。
+
+    角色整身浅色，k-means 会把 F5F8FB / F3F6FA / E5EBF4 这类几乎一样的白各占一格 ——
+    12 色里有 5 格在描述同一个白，于是蓝色头冠、眼睛、裙摆的青蓝全部没名额。
+    这里把「看起来是同一个颜色」的中心并成一个，把省下的名额还给有色相的颜色。
+    """
+    cs = [np.asarray(c, dtype=float) for c in centers]
+    changed = True
+    while changed and len(cs) > 2:
+        changed = False
+        for i in range(len(cs)):
+            for j in range(i + 1, len(cs)):
+                if color_dist(cs[i], cs[j]) < thresh:
+                    cs[i] = (cs[i] + cs[j]) / 2.0
+                    del cs[j]
+                    changed = True
+                    break
+            if changed:
+                break
+    lum = np.array([c @ np.array([0.299, 0.587, 0.114]) for c in cs])
+    cs = [cs[i] for i in np.argsort(lum)]
+    return np.clip(np.round(np.array(cs)), 0, 255)
+
