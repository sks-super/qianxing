+def face_fix(grid, darkfrac, skinfrac, palette, skin_idx, dark_lo=0.30, dark_hi=0.52,
+             skin_min=0.45, max_share=0.22):
+    """把「脸」修成能看得懂的样子。
+
+    为什么要单独修：1 格高的小人，脸只有十几格，刘海、睫毛、瞳色在众数采样里会互相吃掉，
+    结果整张脸糊成一团深色块（看得出是个人，但看不出有眼睛）。
+    做法：按「肤色格」找出每一行脸的范围，行内补成肤色；源图在同一格**真的很暗**的地方
+    （睫毛 / 瞳孔）才放深色，而不是让深色漫到整片脸。
+
+    ⚠️ 安全阀：修出来的肤色格超过实心格的 max_share 就判定「认错了肤色」，原样返回。
+       没有这个阀，白色一旦被当成肤色，整只小人会被刷成一坨肉色。
+    """
+    rows, cols = grid.shape
+    g = grid.copy()
+    sf = skinfrac
+    solid = int((grid >= 0).sum())
+    if solid == 0:
+        return g
+    face_rows = [r for r in range(rows) if (sf[r] >= skin_min).sum() >= 2]
+    if not face_rows:
+        return g
+    # 脸只可能在角色上半部：把明显偏下的行剔掉，避免把裙摆的暖色也当脸
+    top = min(face_rows)
+    face_rows = [r for r in face_rows if r - top <= rows * 0.35]
+    painted = 0
+    for r in face_rows:
+        xs = np.nonzero(sf[r] >= skin_min)[0]
+        lo, hi = int(xs.min()), int(xs.max())
+        for c in range(lo, hi + 1):
+            if g[r, c] < 0:
+                continue
+            d = darkfrac[r, c]
+            if d >= dark_hi:
+                g[r, c] = 0                      # 瞳孔 / 睫毛：用最深的色
+            elif d >= dark_lo:
+                g[r, c] = min(2, len(palette) - 1)   # 眼的阴影
+            else:
+                g[r, c] = skin_idx
+            painted += 1
+    if painted > solid * max_share:
+        return grid                              # 认错肤色 → 放弃本次修形
+    return g
 
 
