+    def table_body(block, key):
+        """取 `key = { ... }` 的表体：花括号配对扫描，不用惰性正则。
+        （惰性正则在 `trees = { },` 这种空表上会一路吞到后面某个 `},` 为止）"""
+        m = re.search(r"\b%s\s*=\s*\{" % key, block)
+        if not m:
+            return ""
+        depth, i = 0, m.end() - 1
+        start = i + 1
+        while i < len(block):
+            ch = block[i]
+            if ch == "{":
+                depth += 1
+            elif ch == "}":
+                depth -= 1
+                if depth == 0:
+                    return block[start:i]
+            i += 1
+        return ""
+
