 M.DEFAULT_WATER_LINE_ALPHA = 70       -- 格子线不透明度（0-255，仅开关为 1 时有效）
 
 -- ----------------------------------------------------------------
+-- ★ 第 34 批：地图主题「空中岛屿」
+--
+--   参考用户给的参考图（「超限素材组」1187 个半透明矩形拼出来的浮空岛）：
+--     · 天空：上方深海蓝 → 中段亮蓝 → 地平线纯白 → 下方一大片白云（占屏下 1/3）
+--     · 岛  ：顶面是**平坦的亮黄绿草地**（224,243,82）、一圈米白窄边、
+--             侧面是**奶白岩石**，越往岛心越深、往岛缘收成锥形
+--     · 岛上要有**格子**，玩家一眼能看出小人站在哪一格
+--
+--   ⚠️ 这个主题不只是换色：背景从「海」换成「天空」、岛底从「一格厚的土带」
+--      换成「岛心往下垂的岩锥」、顶面从「草地素材」换成「纯色格子」——
+--      所以 `level.buildSea` / `level.buildTerrain` 里都有结构分支，见那里的说明。
+--
+--   `DEFAULT_SKY_ISLAND = 1` → 空中岛屿；`0` → 原来的海面主题（深青海 + 沙滩 + 土色侧面）
+--   真机参数 `skyIsland` 覆盖：0 / 空 = 用这里的默认；-1 = 明确关（回到海面主题）。
+-- ----------------------------------------------------------------
+M.DEFAULT_SKY_ISLAND = 1
+M.DEFAULT_SKY_DEPTH = 1.5             -- 岛底岩锥的总高度（× 格）
+                                      --   可用高度只有 4.3 格（74~500px），岛本身占 2.5~3 格，
+                                      --   岩锥再高就会整片沉到下面那条 HUD 里 → 岛看着像「贴地的板」
+M.DEFAULT_SKY_RIM_RATIO = 0.10        -- 空中岛屿的岛缘窄边（× 格，**比海面主题细一半**）
+                                      --   海面主题 0.17 是为了「沙滩」够宽；空中岛屿这条窄边
+                                      --   只是地壳与草地之间的一道金边，太宽会把一格岛
+                                      --   吃成「一小块绿 + 一大圈米白」，格子反而看不清
+M.DEFAULT_SKY_TIP = 0.18              -- 岩锥尖端的宽度（占岛宽的比例，0 = 收成一点）
+M.DEFAULT_SKY_SEGMENTS = 5            -- 岩锥纵向分几段（越多越像岩石、越少越像千层蛋糕）
+M.DEFAULT_SKY_GRID_ALPHA = 170        -- 岛面格线不透明度（0 = 不画格子）
+M.DEFAULT_SKY_CLOUD_COUNT = 6         -- 云团数量（铺在屏幕下半部）
+M.DEFAULT_SKY_BANDS = 48              -- 天空渐变用几条横带（越多越平滑，控件也越多）
+                                      --   ★ 20 条在 720p 下每带 36px，色差能看出一条条横纹；
+                                      --     48 条 → 每带 15px，肉眼已经读成连续渐变。
+
+-- ----------------------------------------------------------------
 -- ★ 美术素材的「内容占比」→ 控件缩放系数
 --   素材四周有留白，真正有内容的部分只占中间一块；
 --   要让「内容」正好压在格子上，控件尺寸就得放大。系数 = 画布尺寸 / 内容尺寸：
@@ -422,6 +454,44 @@
     dust       = "E9DCBE",   -- 落地 / 立木的扬尘（偏沙色：压在绿草与海面上都读得出来）
 }
 
+-- ----------------------------------------------------------------
+-- ★ 空中岛屿调色板（第 34 批）—— 每一个值都是从参考图里**取样**得来的，不是凭感觉调的：
+--     天空竖直扫描（x=40）：1,98,169 → 3,120,189 → 3,146,217 → 111,210,247
+--                          → 247,252,251（地平线）→ 下方 249,249,231 / 255,255,255（云）
+--     岛顶草地主色：224,243,82 / 212,236,74 / 219,243,78   （非常纯的亮黄绿）
+--     侧面岩石    ：242,244,226 / 244,240,207 / 253,253,234（奶白）+ 142,162,181（灰蓝暗部）
+--
+--   只覆盖「大面积地貌」相关的项；树 / 石头 / 木头 / 小人沿用 DEFAULT_PALETTE ——
+--   和雪原主题同一个思路：玩家读地貌靠大色块，小物件保持一致反而更像同一个世界。
+-- ----------------------------------------------------------------
+M.PALETTE_SKY = {
+    -- 天空（自下而上：地平线纯白 → 低空浅蓝 → 高空亮蓝 → 天顶深蓝）
+    skyTop     = "0162A9",
+    skyHigh    = "0888CD",
+    skyMid     = "5FCAF5",
+    skyLow     = "CFEFFC",
+    skyHorizon = "E3F3FB",
+    --   ⚠️ 地平线刻意**不是纯白**：云是白的（cloud = FFFFFF），
+    --     若地平线也纯白，云一压上去就完全看不见了（用户会以为「云没画出来」）。
+    --     参考图下方那片白其实是**云的堆积**，天空本身到底部仍是极浅的蓝。
+    -- 云
+    cloud      = "FFFFFF",
+    cloudWarm  = "FBFBEF",   -- 云受光的一面（参考图里云偏暖白）
+    cloudShade = "B7C8D6",   -- 云的暗部（偏冷灰蓝，压在云团下沿）
+    -- 岛
+    land       = "E0F352",   -- 岛顶草地（参考图主色）
+    tileGrid   = "A8BF2E",   -- 岛面格线（深一档的黄绿，压在同色草地上读得清）
+    sand       = "E8DFB0",   -- 岛缘窄边（淡金；参考图那圈金边）
+    soil       = "EFEAD8",   -- 岩锥中段（奶白）
+    rockWarm   = "F7F3DA",   -- 岩锥顶段（受光，最亮）
+    rockShade  = "B9BFAE",   -- 岩锥底段（背光，偏灰绿）
+    -- 海水相关的项保留一份「天空蓝」，万一有海面元素（涟漪 / 投影）残留不至于跳色
+    water      = "BEE4F5",
+    waterDeep  = "A9D8EE",
+    waterShade = "8FB6C9",
+    shadowLand = "9BA84A",   -- 物体 / 小人在黄绿草地上的接触阴影
+}
+
 -- ================================================================
