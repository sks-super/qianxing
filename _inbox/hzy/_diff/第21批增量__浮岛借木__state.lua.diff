 -- ================================================================
 -- 父对象与层级容器
 --   OnStart 一次性创建，创建顺序即显示层级（从下到上）：
---   bg(海面) → world(地块/物体/小人) → fx(特效) → hud(界面) → fade(黑幕，最顶)
---   ★ 2.5D 视角下，地形 / 物体 / 小人必须**混在同一个容器里**才能按深度排序：
---     「近处一行压住远处一行」「近处的树挡住后面的小人」都靠同级的绘制顺序实现，
---     分成多个容器就只能做到「整个容器压整个容器」，近处的树永远挡不住小人。
+--   bg(海面) → ground(地形) → world(物体/小人) → fx(特效) → hud(界面) → fade(黑幕，最顶)
+--   ★ 地形与物体**分两个容器**（第 21 批）：层级关系从此由「容器创建顺序」保证，
+--     不再依赖同级 SetAsLastSibling —— 真机上那个排序不可靠，地形偶尔会压到小人身上。
+--   ★ 物体之间（树挡住小人、近处木头压远处木头）仍在 world 容器内按深度键排。
 -- ================================================================
 M.parent = nil
 
 M.containerBg      = nil   -- ① 海面（整屏底，跨关卡复用）
-M.containerWorld   = nil   -- ② 世界：地块（网格线/岛缘/顶面）+ 物体 + 小人，按深度显式排序
-M.containerFx      = nil   -- ③ 特效（涟漪；刻意浮在世界之上，免得每步都重排一遍）
-M.containerHud     = nil   -- ④ 界面
-M.containerFade    = nil   -- ⑤ 黑幕过渡（最顶）
+M.containerGround  = nil   -- ② 地形专用层（水面网格 / 地块侧面 / 岛缘描边 / 草地顶面）
+                           --   ★ 第 21 批从 containerWorld 里**拆出来**：真机上同级的
+                           --     SetAsLastSibling 排序并不可靠（池扩容时新控件会排到
+                           --     同级最末 = 压在最上），地形一旦压在小人身上就是
+                           --     「走路时被地图盖住」。拆成独立的、**先创建**的容器后，
+                           --     地形永远在物体 / 小人之下 —— 这一条不再依赖任何 API。
+                           --   ⚠️ 代价：「下一行地块挡住上一行的树」没有了。小人是主角，
+                           --     永远可见比这层遮挡重要，所以接受。
+M.containerSide    = nil   -- ②-a 地形子层：水面网格 + 地块侧面（崖面）
+M.containerRim     = nil   -- ②-b 地形子层：岛缘沙滩描边（压在侧面之上）
+M.containerTile    = nil   -- ②-c 地形子层：草地顶面（压在最上）
+                           --   ★ 三层由**创建顺序**决定上下：侧面 → 描边 → 顶面。
+                           --     这样「草地永远盖住侧面和描边」不靠同级排序，
+                           --     岛内部就再也不会冒出边框 / 棕色横条。
+M.containerWorld   = nil   -- ③ 世界：物体（树 / 木头 / 石头 / 木牌）+ 小人
+M.containerFx      = nil   -- ④ 特效（涟漪；刻意浮在世界之上，免得每步都重排一遍）
+M.containerHud     = nil   -- ⑤ 界面
+M.containerFade    = nil   -- ⑥ 黑幕过渡（最顶）
 
