+-- 柱子该不该画进**前层**（= 挡住小人）？
+--   ★★ 第 43 批：判据从「比小人靠下」收紧成「**屏幕矩形真的和小人相交**」。
+--     为什么：前后两层的先后是**整层**压的（前层永远压在后层之上），所以一根柱子
+--     挪到前层 = 它压到「后层里所有别的柱子」头上。第 42 批把「行号比小人大」的柱子
+--     全塞进前层，于是小人每跨一行，半屏柱子一起换层、和树木/邻柱的遮挡关系整体翻，
+--     用户看到的就是「所有柱子的样子都变了」。
+--     现在只有「同一列 + 这一根真的盖得住小人」的那一根才进前层 —— 其余柱子**永远**
+--     待在后层，外观与小人走到哪儿完全无关。
+--   ★ 三个判据（必须全满足）：
+--     ① 比小人近：行号更大（同行的柱子深度键相同，让它待在后层，小人自然压住它）；
+--     ② 同一列：柱宽 0.49 格、小人宽 0.60 格 → 半宽和 0.55 < 1 格，隔壁列碰不到小人；
+--     ③ 屏幕矩形相交：柱子占 [脚线, 脚线+1.9 格]，小人占 [脚线, 脚线+1.15 格]。
+--        正下方那一格必然相交；再往下一格柱顶已经低于小人脚线，就不该遮挡。
+local function rockIsFront(rk, p, pFoot)
+    if not p or pFoot == nil then return false end
+    local pr = tonumber(p.r)
+    local r = tonumber(rk.r)
+    if pr == nil or r == nil or r <= pr then return false end
+    if (tonumber(rk.c) or -1) ~= (tonumber(p.c) or -2) then return false end
+    local cell = state.cellSize or 1
+    local hpx = cell * (tonumber(config.DEFAULT_PILLAR_H) or 1.9)
+    local fit = (config.DEFAULT_ART_FIT or {}).player or { h = 1.126 }
+    local heroH = cell * (tonumber(fit.h) or 1.126)
+    local foot = groundY(rk.c, r)
+    return (foot < pFoot + heroH) and (pFoot < foot + hpx)
+end
