+function M.ensureRockSplit()
+    if not state.cellSize or not state.rocks then return false end
+    if not rockOccludeOn() or not rockPillarOn() then return false end
+    local pFoot = playerFootY()
+    if pFoot == nil then return false end
+    if state.rockSplitY == pFoot then return false end
+    local rocks = state.rocks
+    local sides = state.rockSideTbl or {}
+    local changed = false
+    for i = 1, #rocks do
+        local rk = rocks[i]
+        local want = groundY(rk.c, rk.r) < pFoot - 0.5
+        if sides[i] ~= want then changed = true break end
+    end
+    if not changed then
+        state.rockSplitY = pFoot          -- 脚线变了但没有柱子换边：只记一下，不动控件
+        return false
+    end
+    if paintRockPillars(utils.resolvePalette(state.levelConfig)) then M.restackWorld() end
+    return true
+end
