+        state.heroTurnDur = 0
+        state.heroTurnFrom = ""
+        state.heroFacing = target
+        M.repaintHeroForFacing()
+        applyHeroTurnScale(1)
+        return
+    end
+
+    state.heroTurnT = t
+    local p = t / dur
+    if p >= 0.5 and state.heroFacing ~= target then
+        state.heroFacing = target
+        M.repaintHeroForFacing()
     end
+    local squash = state.heroTurnSquashCfg or tonumber(config.DEFAULT_HERO_TURN_SQUASH) or 0.30
