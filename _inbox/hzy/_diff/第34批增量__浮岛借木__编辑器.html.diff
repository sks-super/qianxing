+// ★ 空中岛屿（第 34 批）：与 level.lua 的 hex2rgb / rgb2hex / mixHex / SKY_STOPS 同源
+function hex2rgb(h) {
+    const s = String(h || "FFFFFF").replace("#", "");
+    return [parseInt(s.slice(0, 2), 16) || 0,
+            parseInt(s.slice(2, 4), 16) || 0,
+            parseInt(s.slice(4, 6), 16) || 0];
+}
+function mixHex(a, b, t) {
+    const A = hex2rgb(a), B = hex2rgb(b);
+    t = Math.max(0, Math.min(1, t));
+    const q = v => Math.round(Math.max(0, Math.min(255, v))).toString(16).padStart(2, "0").toUpperCase();
+    return q(A[0] + (B[0] - A[0]) * t) + q(A[1] + (B[1] - A[1]) * t) + q(A[2] + (B[2] - A[2]) * t);
+}
+const SKY_STOPS = [
+    [0.00, "skyTop"], [0.14, "skyHigh"], [0.34, "skyMid"],
+    [0.52, "skyLow"], [0.66, "skyHorizon"], [1.00, "skyHorizon"],
+];
+function skyColorAt(P, t) {
+    let prev = SKY_STOPS[0];
+    if (t <= prev[0]) return P[prev[1]];
+    for (let i = 1; i < SKY_STOPS.length; i++) {
+        const cur = SKY_STOPS[i];
+        if (t <= cur[0]) {
+            const span = cur[0] - prev[0];
+            const k = span > 0 ? (t - prev[0]) / span : 0;
+            return mixHex(P[prev[1]], P[cur[1]], k);
+        }
+        prev = cur;
+    }
+    return P[prev[1]];
+}
