+// 天空 + 云（屏幕空间固定；云用固定种子，重绘时不会跳位置）
+function drawSkyBackground(P) {
+    const W = canvas.width, H = canvas.height;
+    const n = Math.max(4, Math.floor(DEFAULTS.sky_bands));
+    const bandH = H / n;
+    for (let i = 0; i < n; i++)
+        rect(0, i * bandH, W + 16, bandH + 2, skyColorAt(P, (i + 0.5) / n), 1);
