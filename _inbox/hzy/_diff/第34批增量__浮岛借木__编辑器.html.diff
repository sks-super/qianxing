+    const puffH = H * 0.038;
+    for (let k = 0; k < DEFAULTS.sky_cloud_count; k++) {
+        const w = W * (0.15 + rnd() * 0.24);
+        const x = (rnd() - 0.5) * (W + w);
+        const yc = H * (0.56 + rnd() * 0.34);              // 屏幕下半部
+        const puffs = 4 + Math.floor(rnd() * 3);
