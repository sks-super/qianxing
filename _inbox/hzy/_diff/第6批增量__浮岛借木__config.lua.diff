@@ -160,6 +160,12 @@
 --     玩法上唯一的差别就是「倒完留不留树根」，所以推立起来的那根不能当成新树。
 --   ★ 撞倒与推（侧推 / 正推）都会让小人**顺势前进一格**（撞倒 = 站到树根上，
 --     推 = 站到木头原来占的那一格），能不能前进仍按 0.25 格的跨步上限判一次。
+--   ★ 「躺 / 立」两态在**画面上必须一眼分得开** —— 这是玩法可读性的前提：
+--       躺 = 长而扁（1.0 × 0.5 格）、深一点偏灰的旧木色、贴地一条暗边、两端切面带年轮；
+--       立 = 窄而高（0.36 × 1.0 格）、亮一点偏暖的新木色、竖向受光、顶端一圈亮切面、
+--             根部扎进土里的一小撮土堆 + 暗影。
+--     切换两态时还有一段过渡补间（倒下 = 甩过头再落定 + 落地扬尘；
+--     立起 = 往上过冲一下再站稳），见 level.lua 的 `animateObject`。
 -- ================================================================
 M.DEFAULT_MAX_STEP = 0.25             -- 小人能向上跨越的最大高度差
 M.DEFAULT_H_ROOT = 0.25               -- 树根（推倒树木后原地留下）顶面高度，可踩
@@ -178,6 +184,17 @@
 M.DEFAULT_RIPPLE_TIME = 0.45          -- 动作涟漪特效时长（秒）
 M.DEFAULT_RIPPLE_SIZE = 70            -- 涟漪特效初始尺寸（像素）
 M.DEFAULT_FX_ALPHA = 170              -- 涟漪特效峰值不透明度（0-255）
+
+-- ★ 木头「倒 / 立」的过渡动画（表现层）
+--   同一根木头有两个状态（躺 / 立），切换时**一定要有过程**：
+--   瞬间变形的话，玩家只会看到「有东西闪了一下」，读不出「它倒了 / 它立起来了」。
+--   这段补间就是让「倒下」和「立起来」在视觉上彻底分开的关键。
+M.DEFAULT_OBJ_ANIM_TIME = 0.22        -- 木头倒 / 立的过渡时长（秒）；比小人走一格更长，看得清
+M.DEFAULT_OBJ_ANIM_OVERSHOOT = 1.35   -- 回弹过冲量（1 = 不过冲）；倒下时「甩过头再落定」
+M.DEFAULT_DUST_TIME = 0.34            -- 落地 / 立木扬尘时长（秒）
+M.DEFAULT_DUST_SIZE = 0.62            -- 扬尘初始直径（格）
+M.DEFAULT_DUST_ALPHA = 150            -- 扬尘峰值不透明度（0-255）
+
 M.DEFAULT_COAST_PAD = 5               -- 沙滩描边向外扩出的宽度（像素）
 M.DEFAULT_WATER_GRID_ALPHA = 96       -- 水下网格装饰不透明度（0-255）
 M.DEFAULT_HINT_WRAP = 26              -- 提示文本每行最多几个字符（按 UTF-8 字符数折行）
