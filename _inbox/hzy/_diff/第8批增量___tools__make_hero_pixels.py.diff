--- a/_tools/make_hero_pixels.py
+++ b/_tools/make_hero_pixels.py
@@ -0,0 +1,306 @@
+# -*- coding: utf-8 -*-
+"""把四张小人的透明立绘「画」成 Lua 数据 —— 少色像素矩形（不是图片引用）。
+
+为什么要这么做：
+  千星客户端脚本只能拿到矩形 / 图片 / 文本 / 容器四类控件，没有「画一张画」的能力。
+  要「用绘画的方式」把立绘放进游戏（而不是 SetImage 引用 PNG），
+  唯一的办法就是**把立绘压成有限色的像素矩形**，运行时用几十块纯色矩形拼出来。
+
+关键工艺（每一步都为了解决一个具体问题）：
+  1. 四张共用一套调色板 —— 否则转身时头发会从银白跳到灰白，像换了个人。
+  2. 每格采样用「众数」而不是「平均值」—— 平均会把深色描边和眼睛一起抹淡，
+     角色只剩一团灰白；众数能保住占比最高的那个颜色，描边和瞳孔都留得住。
+  3. 3×3 众数滤波去噪 —— JPG 压缩噪点会在格子边缘炸出孤立色块。
+  4. 贪心矩形合并（先按行 RLE，再向下合并同色同宽）—— 控件数从「像素数」降到「色块数」，
+     一格裙摆是一块矩形而不是二十个小方块。
+  5. 内容高固定 ROWS 格 → 运行时一块 = cell/ROWS，正好把角色做成 1 格高，
+     且格子边长怎么变都不会变形（正方形像素）。
+
+用法：
+  python _tools/make_hero_pixels.py                 # 默认 ROWS=32
+  python _tools/make_hero_pixels.py --rows 40       # 更细，控件更多
+输出：
+  浮岛借木/heroArt.lua              ← 运行时数据（level.lua 读它）
+  浮岛借木/预览_像素小人.png         ← 离线核对：把矩形画回去，放大对照
+"""
+
+import argparse
+import os
+import sys
+
+import numpy as np
+from PIL import Image, ImageDraw
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+GAME = os.path.join(HERE, "..", "浮岛借木")
+ART = os.path.join(GAME, "素材")
+FACES = ["S", "W", "A", "D"]
+FILES = {"S": "人物_正面.png", "W": "人物_背面.png",
+         "A": "人物_左侧.png", "D": "人物_右侧.png"}
+LABEL = {"S": "S 向下 · 正面", "W": "W 向上 · 背面",
+         "A": "A 向左 · 左视", "D": "D 向右 · 右视"}
+
+ALPHA_MIN = 100      # 视为「有这个像素」的 alpha 门槛
+COVER_MIN = 0.34     # 一格内至少这么多像素有内容，这一格才算实心（去毛边）
+PALETTE_K = 12       # 调色板颜色数（少一点 → 色块更整、控件更少，浅色不会碎成一地）
+ANCHORS = [(242, 216, 196)]   # 肤色（暖）—— 钉死，别让 k-means 并进裙子的冷白
+DARK_SHARE = 0.16    # 格内「暗像素」占到这么多，就优先用暗色（保住描边与眼睛）
+DARK_LUM_PCT = 12    # 暗像素的亮度分位（内容像素的 p12）
+
+
+def load_face(name):
+    p = os.path.join(ART, FILES[name])
+    if not os.path.exists(p):
+        sys.exit("找不到素材：%s" % p)
+    return np.array(Image.open(p).convert("RGBA")).astype(np.float64)
+
+
+def union_bbox(imgs):
+    """四张共用的裁剪框 —— 必须共用，否则换朝向时脚底会上下跳。"""
+    xs0, xs1, ys0, ys1 = [], [], [], []
+    for im in imgs.values():
+        ys, xs = np.nonzero(im[:, :, 3] > ALPHA_MIN)
+        xs0.append(xs.min()); xs1.append(xs.max())
+        ys0.append(ys.min()); ys1.append(ys.max())
+    return min(xs0), max(xs1), min(ys0), max(ys1)
+
+
+# 「冷暖权重」：红 / 蓝差就是冷暖轴。角色整身都是浅色（银发白裙），
+# 若按等权 RGB 聚类，冷灰的头发和暖白的皮肤会并成一类 → 脸和头发糊成一片。
+# 把红、蓝各放大一点，色相差异才争得过亮度差异。
+CHROMA_W = np.array([1.65, 1.0, 1.65])
+
+
+def build_palette(pixels, k):
+    """k-means 取主色。初始化用「按亮度等距取点」——比随机稳，也不容易全挤在白色上。"""
+    rng = np.random.RandomState(20261021)
+    sample = pixels[rng.choice(len(pixels), size=min(40000, len(pixels)), replace=False)]
+    lum = sample @ np.array([0.299, 0.587, 0.114])
+    order = np.argsort(lum)
+    centers = sample[order[np.linspace(0, len(order) - 1, k).astype(int)]].copy()
+    for _ in range(24):
+        d = (((sample[:, None, :] - centers[None, :, :]) * CHROMA_W) ** 2).sum(axis=2)
+        lab = d.argmin(axis=1)
+        for i in range(k):
+            sel = sample[lab == i]
+            if len(sel):
+                centers[i] = sel.mean(axis=0)
+    # ★ 锚色：皮肤的暖色必须占一格。
+    #   全身都是浅色时，k-means 会把「暖白皮肤」和「冷白裙子」并成一类，
+    #   结果脸和头发糊成一个灰白团 —— 角色只剩剪影，认不出是谁。
+    #   把离锚色最近的那个中心直接钉成锚色，脸的暖度就稳住了。
+    for anchor in ANCHORS:
+        a = np.array(anchor, dtype=float)
+        i = int(np.argmin((((centers - a) * CHROMA_W) ** 2).sum(axis=1)))
+        centers[i] = a
+    # 按亮度从暗到亮排序，输出时索引即明暗次序（调试时一眼能看出层次）
+    lum = centers @ np.array([0.299, 0.587, 0.114])
+    centers = centers[np.argsort(lum)]
+    return np.clip(np.round(centers), 0, 255)
+
+
+def nearest_index(patch_pixels, palette):
+    d = (((patch_pixels[:, None, :] - palette[None, :, :]) * CHROMA_W) ** 2).sum(axis=2)
+    return d.argmin(axis=1)
+
+
+def sample_grid(im, bbox, rows, cols, palette, dark_lum=None):
+    """一格里取「众数色」。返回 (rows, cols) 的索引图，-1 = 透明。
+
+    ★ 暗色优先：描边和瞳孔在格子里只占少数，纯众数会把它们投掉，
+      于是角色变成一团灰白（试过，糊得认不出脸）。
+      所以格内暗像素占到 DARK_SHARE 就改用「暗像素的众数」——
+      这一步是「能不能看出五官」的关键。
+    """
+    x0, x1, y0, y1 = bbox
+    bw, bh = x1 - x0 + 1, y1 - y0 + 1
+    wts = np.array([0.299, 0.587, 0.114])
+    grid = np.full((rows, cols), -1, dtype=np.int32)
+    for r in range(rows):
+        sy0 = y0 + int(round(r * bh / rows))
+        sy1 = y0 + int(round((r + 1) * bh / rows))
+        for c in range(cols):
+            sx0 = x0 + int(round(c * bw / cols))
+            sx1 = x0 + int(round((c + 1) * bw / cols))
+            patch = im[sy0:max(sy1, sy0 + 1), sx0:max(sx1, sx0 + 1)]
+            solid = patch[:, :, 3] > ALPHA_MIN
+            if solid.mean() < COVER_MIN:
+                continue
+            rgb = patch[:, :, :3][solid]
+            if dark_lum is not None:
+                dark = solid & ((patch[:, :, :3] @ wts) < dark_lum)
+                if dark.mean() >= DARK_SHARE:
+                    rgb = patch[:, :, :3][dark]
+            idx = nearest_index(rgb, palette)
+            vals, cnt = np.unique(idx, return_counts=True)
+            grid[r, c] = int(vals[cnt.argmax()])
+    return grid
+
+
+def denoise(grid, passes=1):
+    """3×3 众数滤波：只改「被多数邻居包围」的孤立格，不动边缘轮廓。"""
+    g = grid.copy()
+    rows, cols = g.shape
+    for _ in range(passes):
+        src = g.copy()
+        for r in range(rows):
+            for c in range(cols):
+                if src[r, c] < 0:
+                    continue
+                nb = []
+                for dr in (-1, 0, 1):
+                    for dc in (-1, 0, 1):
+                        rr, cc = r + dr, c + dc
+                        if 0 <= rr < rows and 0 <= cc < cols and src[rr, cc] >= 0:
+                            nb.append(src[rr, cc])
+                if len(nb) < 5:
+                    continue
+                vals, cnt = np.unique(nb, return_counts=True)
+                # 邻居里同一个色占绝对多数（≥6/9 且不是自己）→ 改成它
+                if cnt.max() >= 6 and vals[cnt.argmax()] != src[r, c]:
+                    g[r, c] = int(vals[cnt.argmax()])
+    return g
+
+
+def to_rects(grid):
+    """行 RLE + 向下合并。输出 [(x, y, w, h, colorIndex), ...]，y 从上往下。"""
+    rows, cols = grid.shape
+    # ① 每行先 RLE
+    runs = []   # (y, x, w, c)
+    for r in range(rows):
+        c = 0
+        while c < cols:
+            v = grid[r, c]
+            if v < 0:
+                c += 1
+                continue
+            s = c
+            while c + 1 < cols and grid[r, c + 1] == v:
+                c += 1
+            runs.append([r, s, c - s + 1, int(v)])
+            c += 1
+    # ② 向下合并：同 x / 同 w / 同色，且上一行正好有一条相同的
+    rects = []
+    open_map = {}   # (x, w, c) -> rect 下标
+    for run in runs:
+        y, x, w, c = run
+        key = (x, w, c)
+        idx = open_map.get(key)
+        if idx is not None and rects[idx][1] + rects[idx][3] == y:
+            rects[idx][3] += 1          # 长高一行
+        else:
+            rects.append([x, y, w, 1, c])
+            open_map[key] = len(rects) - 1
+    # 清理：合并可能打断同一 key 的连续性，逐条重算（简单可靠）
+    return [tuple(rr) for rr in rects]
+
+
+def render_preview(grids, palette, out, scale=10, pad=12):
+    rows, cols = next(iter(grids.values())).shape
+    n = len(FACES)
+    cw, chh = cols * scale, rows * scale
+    W = n * (cw + pad) + pad
+    H = chh + 2 * pad
+    img = Image.new("RGB", (W, H), (36, 40, 44))
+    d = ImageDraw.Draw(img)
+    for i, f in enumerate(FACES):
+        ox = pad + i * (cw + pad)
+        for r in range(rows):
+            for c in range(cols):
+                v = grids[f][r, c]
+                if v < 0:
+                    continue
+                col = tuple(int(x) for x in palette[v])
+                d.rectangle([ox + c * scale, pad + r * scale,
+                             ox + (c + 1) * scale - 1, pad + (r + 1) * scale - 1], fill=col)
+        d.rectangle([ox, pad, ox + cw - 1, pad + chh - 1], outline=(80, 90, 100))
+    img.save(out)
+    return img.size
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--rows", type=int, default=32, help="角色内容高的像素行数")
+    ap.add_argument("--cols", type=int, default=0, help="0 = 按原图宽高比自动算")
+    args = ap.parse_args()
+
+    imgs = {f: load_face(f) for f in FACES}
+    bbox = union_bbox(imgs)
+    x0, x1, y0, y1 = bbox
+    bw, bh = x1 - x0 + 1, y1 - y0 + 1
+    rows = int(args.rows)
+    cols = int(args.cols) if args.cols > 0 else int(round(rows * bw / float(bh)))
+    print("并集裁剪 %dx%d（宽高比 %.4f）→ 网格 %d 列 × %d 行" % (bw, bh, bw / float(bh), cols, rows))
+
+    # 调色板：四张内容像素一起喂
+    px = []
+    for f in FACES:
+        sub = imgs[f][y0:y1 + 1, x0:x1 + 1]
+        px.append(sub[:, :, :3][sub[:, :, 3] > ALPHA_MIN])
+    px = np.concatenate(px, axis=0)
+    palette = build_palette(px, PALETTE_K)
+    lum_all = px @ np.array([0.299, 0.587, 0.114])
+    dark_lum = float(np.percentile(lum_all, DARK_LUM_PCT))
+    print("调色板 %d 色；暗色阈值 = 亮度 p%d = %.1f" % (len(palette), DARK_LUM_PCT, dark_lum))
+
+    grids, stats = {}, {}
+    for f in FACES:
+        g = sample_grid(imgs[f], bbox, rows, cols, palette, dark_lum)
+        g = denoise(g, passes=2)
+        grids[f] = g
+        rects = to_rects(g)
+        stats[f] = rects
+        print("  %s：实心格 %4d  矩形 %3d 块" % (LABEL[f], int((g >= 0).sum()), len(rects)))
+
+    # ---- 写 Lua ----
+    hexes = ["%02X%02X%02X" % tuple(int(v) for v in palette[i]) for i in range(len(palette))]
+    out_lua = os.path.join(GAME, "heroArt.lua")
+    L = []
+    L.append("-- ================================================================")
+    L.append("-- 浮岛借木 · 小人的「像素画」数据（由 _tools/make_hero_pixels.py 生成，别手改）")
+    L.append("--")
+    L.append("-- ★ 为什么要这样存：千星脚本只能实例化矩形 / 图片 / 文本 / 容器控件，")
+    L.append("--   没有「把一张 PNG 画出来」的接口。所以角色不是引用图片，而是")
+    L.append("--   **用 %d 种颜色、几百块纯色矩形拼出来的像素画** —— 换朝向就是换一套矩形。" % len(palette))
+    L.append("--")
+    L.append("-- ★ 坐标单位：网格格（不是像素）。整个网格 = COLS × ROWS 格，")
+    L.append("--   运行时一块的边长 = cellSize / ROWS，于是内容正好 1 格高，")
+    L.append("--   而且格子边长怎么自适应都不会把角色拉变形（像素恒为正方形）。")
+    L.append("-- ★ 四张共用同一个网格与同一套调色板：转身时脚底不动、配色不跳。")
+    L.append("--")
+    L.append("-- RECT 项 = { x, y, w, h, c }：左上角格坐标 + 宽高（格）+ 调色板索引。")
+    L.append("--   y 从上往下数（0 = 头顶那行）；绘制时脚本再翻成 UI 的向上为正。")
+    L.append("-- ================================================================")
+    L.append("")
+    L.append("local M = {}")
+    L.append("")
+    L.append("M.COLS = %d   -- 网格宽（格）" % cols)
+    L.append("M.ROWS = %d   -- 网格高（格）；角色内容高 = 1 格 → 每格像素 = cellSize / ROWS" % rows)
+    L.append("")
+    L.append("-- 调色板（从暗到亮排序）：四张图共用，转身时不会有色偏")
+    L.append("M.COLORS = {")
+    for i, hx in enumerate(hexes):
+        L.append('    "%s",%s-- %d' % (hx, " " * (11 - len(hx)), i))
+    L.append("}")
+    L.append("")
+    L.append("-- 每个朝向的矩形块")
+    L.append("M.SPRITES = {")
+    for f in FACES:
+        L.append("    %s = {   -- %d 块" % (f, len(stats[f])))
+        for (x, y, w, h, c) in stats[f]:
+            L.append("        { %d, %d, %d, %d, %d }," % (x, y, w, h, c))
+        L.append("    },")
+    L.append("}")
+    L.append("")
+    L.append("return M")
+    with open(out_lua, "w", encoding="utf-8", newline="\n") as fh:
+        fh.write("\n".join(L) + "\n")
+    print("\n-> %s（%d 行，%d 字节）" % (out_lua, len(L), os.path.getsize(out_lua)))
+    print("   调色板：" + " ".join(hexes))
+
+    size = render_preview(grids, palette, os.path.join(GAME, "预览_像素小人.png"))
+    print("-> %s %s（放大 10 倍，四向对照）" % (os.path.join(GAME, "预览_像素小人.png"), size))
+
+
+if __name__ == "__main__":
+    main()
